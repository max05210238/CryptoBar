 167          /******************************
 168          *在指定位置打印一个字符(用户自定义,所有CG-ROM中的)
 169          *x:0~11;chr:要显示的字符编码
 170          *******************************/
 171          void S1201_WriteOneChar(unsigned char x, unsigned char chr)
 172          {
 173   1        cs=0; //开始传输 
 174   1        write_6302(0x20+x);//地址寄存器起始位置
 175   1        write_6302(chr+0x30); 
 176   1        cs=1; //停止传输
 177   1        //S1201_show(); 
 178   1      }
