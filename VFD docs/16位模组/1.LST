  96          void write_6302(unsigned char w_data)
  97           { 
  98   1          unsigned char i;      
  99   1          for(i=0;i<8;i++)   
 100   1          {  
 101   2              clk=0;    
 102   2              if( (w_data&0x01) == 0x01)       
 103   2            { 
 104   3                 din=1;      
 105   3                }        
 106   2          else       
 107   2       { 
 108   3                  din=0;    
 109   3        } 
 110   2           w_data>>=1;              
 111   2           clk=1;    
 112   2         
 113   2        }
 114   1       }
