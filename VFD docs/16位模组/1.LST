 182          /******************************
 183          *在指定位置打印字符串
 184          *(仅适用于英文,标点,数字)
 185          *x:0~11;str:要显示的字符串
 186          *******************************/
 187          void S1201_WriteStr(unsigned char x, char *str)
 188          {
 189   1        cs=0; //开始传输 
 190   1        write_6302(0x20+x);//地址寄存器起始位置
 191   1        
 192   1        while (*str) 
 193   1        {
 194   2          write_6302(*str); //ascii与对应字符表转换 
 195   2          str++;
 196   2        } 
 197   1        cs=1; //停止传输
 198   1        
 199   1        //S1201_show(); 
 200   1      }
 201          
 202          /******************************
 203          *自定义字符(总共支持8个自定义字符)
 204          *取模时,自上到下:低位到高位;自左到右;
 205          *x:0~7;str:字模(5个8位的数组)
 206          *******************************/
 207          void S1201_WriteUserFont(unsigned char x, unsigned char y,unsigned char *s)
 208          {
 209   1        unsigned char i=0;
 210   1          unsigned char ii=0;
 211   1        cs=0; //开始传输 
 212   1        write_6302(0x40+y);//地址寄存器起始位置
 213   1        
 214   1          for(i=0;i<5;i++)
 215   1           write_6302(s[i]);
 216   1        cs=1; //停止传输
 217   1      
 218   1        cs=0;
 219   1        write_6302(0x20+x);
 220   1        write_6302(0x00+y);   
 221   1        cs=1;
 222   1      
 223   1        //S1201_show();
 224   1      }
